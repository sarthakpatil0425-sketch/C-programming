4. Swap two numbers using temporary variable
#include <stdio.h>

int main()
{
    int a, b, temp;

    printf("Enter two numbers: ");
    scanf("%d %d", &a, &b);

    temp = a;
    a = b;
    b = temp;

    printf("After swapping:");
    printf("\na = %d", a);
    printf("\nb = %d", b);

    return 0;
}
